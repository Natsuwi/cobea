# Docker (NAS) — hostname = container_name of shared Postgres
DATABASE_URL=postgresql://cobea:CHANGE_ME@shared-postgres:5432/cobea_db
# Dev local Windows — use NAS IP instead:
# DATABASE_URL=postgresql://cobea:CHANGE_ME@IP_DU_NAS:5432/cobea_db
# Special chars in password must be URL-encoded ($ → %24, * → %2A)

PORT=3847
STORAGE_MODE=standard
# STORAGE_MODE is unused for per-user preference; kept for backwards compat.
# Google OAuth can be set here (shared) OR entered per-user in account settings.
CORS_ORIGIN=http://localhost:3000
PUBLIC_API_URL=
JWT_SECRET=change-me-to-a-long-random-string
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3847/api/auth/google/callback
