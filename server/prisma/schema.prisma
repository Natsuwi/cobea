generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                     String    @id @default(cuid())
  email                  String    @unique
  passwordHash           String    @map("password_hash")
  /// 'standard' | 'google' — chosen in account settings
  storageMode            String    @default("standard") @map("storage_mode")
  /// Optional per-user OAuth app (fallback: server GOOGLE_CLIENT_*)
  googleClientId         String?   @map("google_client_id")
  googleClientSecret     String?   @map("google_client_secret")
  googleRefreshToken     String?   @map("google_refresh_token")
  googleAccessToken      String?   @map("google_access_token")
  googleTokenExpiry      DateTime? @map("google_token_expiry")
  /// Drive folder where new Cobea uploads are stored
  googleUploadFolderId   String?   @map("google_upload_folder_id")
  googleUploadFolderName String?   @map("google_upload_folder_name")
  /// JSON: [{ id, name }] Drive folders to sync into the gallery
  googleSyncFolders      Json?     @map("google_sync_folders")
  googleLastSyncAt       DateTime? @map("google_last_sync_at")
  createdAt              DateTime  @default(now()) @map("created_at")
  profile                Profile?

  @@map("users")
}

/// Global Drive API usage for the OAuth project (shared across users).
model DriveApiUsage {
  id        String   @id @default("global")
  /// UTC calendar day YYYY-MM-DD
  day       String
  requests  Int      @default(0)
  /// Estimated quota units consumed today
  units     Int      @default(0)
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("drive_api_usage")
}

model Profile {
  id        String   @id @default(cuid())
  userId    String   @unique @map("user_id")
  name      String
  avatarUrl String?  @map("avatar_url")
  theme     String   @default("light")
  createdAt DateTime @default(now()) @map("created_at")

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  folders Folder[]
  cards   Card[]

  @@map("profiles")
}

model Folder {
  id        String   @id @default(cuid())
  profileId String   @map("profile_id")
  name      String
  icon      String   @default("folder")
  createdAt DateTime @default(now()) @map("created_at")

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  cards   Card[]

  @@index([profileId])
  @@map("folders")
}

enum ItemKind {
  image
  note
  moodboard
}

enum ItemSource {
  default
  uploaded
  url
  note
  drive
}

model Card {
  id                   String     @id @default(cuid())
  profileId            String     @map("profile_id")
  folderId             String?    @map("folder_id")
  kind                 ItemKind   @default(image)
  title                String
  url                  String     @default("")
  tags                 String[]   @default([])
  dominantColor        String?    @map("dominant_color")
  isFavorite           Boolean    @default(false) @map("is_favorite")
  width                Int?
  height               Int?
  aspectRatio          Float?     @map("aspect_ratio")
  source               ItemSource @default(default)
  markdown             String?
  additionalNotes      String?    @map("additional_notes")
  moodboardPlacements  Json?      @map("moodboard_placements")
  createdAt            DateTime   @default(now()) @map("created_at")
  updatedAt            DateTime   @updatedAt @map("updated_at")

  profile Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  folder  Folder?   @relation(fields: [folderId], references: [id], onDelete: SetNull)
  file    CardFile?

  @@index([profileId])
  @@index([folderId])
  @@map("cards")
}

model CardFile {
  id              String    @id @default(cuid())
  cardId          String    @unique @map("card_id")
  mimeType        String    @map("mime_type")
  filename        String
  /// Standard mode: full binary. Google mode: usually null (blob on Drive).
  data            Bytes?
  /// Drawing overlay (PNG) — always in Postgres for both modes.
  drawingData     Bytes?    @map("drawing_data")
  drawingMimeType String?   @map("drawing_mime_type")
  /// Google Drive file id (Google mode)
  driveFileId     String?   @map("drive_file_id")
  thumbnailLink   String?   @map("thumbnail_link")
  /// Cached Drive thumbnail bytes — avoids repeated Drive/thumbnail calls
  thumbnailData   Bytes?    @map("thumbnail_data")
  thumbnailMime   String?   @map("thumbnail_mime")
  size            BigInt?
  driveModifiedAt DateTime? @map("drive_modified_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  card Card @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@index([driveFileId])
  @@map("card_files")
}
